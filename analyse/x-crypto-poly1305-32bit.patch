+++ b/internal/poly1305/sum_32bit_test.go	2026-10-29 12:29:42
@@ -0,0 +1,58 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package poly1305
+
+import (
+	"math/rand"
+	"testing"
+)
+
+// TestDonna32MatchesGeneric64 checks that both update implementations produce
+// the same state for random keys, states and message lengths, including
+// partial final blocks and accumulators close to the reduction bound.
+func TestDonna32MatchesGeneric64(t *testing.T) {
+	rng := rand.New(rand.NewSource(1))
+	for i := 0; i < 20000; i++ {
+		var key [32]byte
+		rng.Read(key[:])
+		var a macState
+		initialize(&key, &a)
+		// Arbitrary starting accumulator below 2 · (2¹³⁰ - 5).
+		a.h[0], a.h[1], a.h[2] = rng.Uint64(), rng.Uint64(), uint64(rng.Intn(8))
+		b := a
+		msg := make([]byte, rng.Intn(200))
+		rng.Read(msg)
+		updateGeneric64(&a, msg)
+		updateDonna32(&b, msg)
+		var ta, tb [TagSize]byte
+		finalize(&ta, &a.h, &a.s)
+		finalize(&tb, &b.h, &b.s)
+		if ta != tb {
+			t.Fatalf("iteration %d (len %d): tags differ %x / %x", i, len(msg), ta, tb)
+		}
+	}
+}
+
+func BenchmarkDonna32(b *testing.B) {
+	var key [32]byte
+	var s macState
+	initialize(&key, &s)
+	msg := make([]byte, 1420)
+	b.SetBytes(int64(len(msg)))
+	for i := 0; i < b.N; i++ {
+		updateDonna32(&s, msg)
+	}
+}
+
+func BenchmarkGeneric64(b *testing.B) {
+	var key [32]byte
+	var s macState
+	initialize(&key, &s)
+	msg := make([]byte, 1420)
+	b.SetBytes(int64(len(msg)))
+	for i := 0; i < b.N; i++ {
+		updateGeneric64(&s, msg)
+	}
+}
