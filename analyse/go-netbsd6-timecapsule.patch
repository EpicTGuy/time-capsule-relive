+TEXT runtime·lwp_park(SB),NOSPLIT,$0
+	// Time Capsule (NetBSD 6) : ___lwp_park60 n'existe pas ; ___lwp_park50 (434)
+	// prend (ts absolu CLOCK_REALTIME, unpark, hint, unparkhint). semasleep convertit.
+	MOVW ts+8(FP), R0		// arg 1 - ts
+	MOVW unpark+12(FP), R1		// arg 2 - unpark
+	MOVW hint+16(FP), R2		// arg 3 - hint
+	MOVW unparkhint+20(FP), R3	// arg 4 - unparkhint
+	SWI $0xa001b2			// SWI_OS_NETBSD | 434
 	MOVW	R0, ret+24(FP)
 	RET
 
