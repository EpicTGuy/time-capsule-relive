diff -ru a/src/runtime/signal_netbsd.go b/src/runtime/signal_netbsd.go
--- a/src/runtime/signal_netbsd.go	2026-10-20 00:20:36
+++ b/src/runtime/signal_netbsd.go	2026-10-29 13:01:41
@@ -17,7 +17,10 @@
 	/*  9 */ {0, "SIGKILL: kill"},
 	/* 10 */ {_SigPanic + _SigUnblock, "SIGBUS: bus error"},
 	/* 11 */ {_SigPanic + _SigUnblock, "SIGSEGV: segmentation violation"},
-	/* 12 */ {_SigThrow, "SIGSYS: bad system call"},
+	// NetBSD 6 (AirPort Time Capsule) : les appels système apparus après NetBSD 6
+	// (wait6, ___lwp_park60…) envoient SIGSYS puis renvoient ENOSYS. On laisse
+	// passer le signal pour que la bibliothèque standard utilise ses replis.
+	/* 12 */ {_SigNotify, "SIGSYS: bad system call"},
 	/* 13 */ {_SigNotify, "SIGPIPE: write to broken pipe"},
 	/* 14 */ {_SigNotify, "SIGALRM: alarm clock"},
 	/* 15 */ {_SigNotify + _SigKill, "SIGTERM: termination"},
